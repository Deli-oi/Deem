# Copy to .env.local to read a real ESP32 instead of the fixture mock.
# VITE_BACKEND=mqtt
# VITE_MQTT_URL=ws://deem-pi.local:9001
# VITE_DEVICE_ID=esp32-pot-01

# Cloud (optional): the hosted server for plants/answers/voice, and the ingest service that starts and stops data collection.
# Without VITE_INGEST_URL the screen never tells the cloud anything (mock mode behaves like this).
# VITE_API_BASE=https://deem-production.up.railway.app
# VITE_INGEST_URL=https://authentic-perception-production-245b.up.railway.app
