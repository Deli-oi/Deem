[Unit]
Description=Deem health UI (serves the built demo/ UI over HTTP for the kiosk)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and paths to match your Pi setup.
User=connorlamora
WorkingDirectory=/home/connorlamora/Deem/demo
# Port the kiosk browser points at (see deem-kiosk.service DEEM_UI_URL).
Environment=PORT=3000
# Build first with pi/deploy/build-ui.sh so demo/dist exists, then:
#   npm start -> serves demo/dist on $PORT (uses the `serve` dep).
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
