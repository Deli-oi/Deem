[Unit]
Description=Deem SPI-TFT kiosk (minimal X + Chromium plant-health UI, no desktop)
# Needs the local UI server; takes over tty1 instead of the login getty.
After=deem-ui.service systemd-user-sessions.service getty@tty1.service
Wants=deem-ui.service
Conflicts=getty@tty1.service

[Service]
Type=simple
# Adjust User and paths to match your Pi setup.
User=connorlamora
# Start our own X server on the console (no desktop environment).
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
# Where the UI is served (matches PORT in deem-ui.service) and which framebuffer
# the SPI TFT exposes (change if your overlay creates something other than fb1).
Environment=DEEM_UI_URL=http://localhost:3000
Environment=DEEM_FB=/dev/fb1
ExecStart=/home/connorlamora/Deem/pi/deploy/kiosk/kiosk-session.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
